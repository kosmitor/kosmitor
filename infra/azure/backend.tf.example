# Remote state. terraform.tfstate holds the app's secrets in clear (the database
# password, the secret key, the email service's connection string) and is the
# only record of what this stack owns, so it does not belong on a laptop.
# ./state-storage.sh creates the storage for it once per subscription, in a
# resource group of its own that rebuild.sh never touches, grants you the blob
# role Terraform needs, and prints the backend.hcl lines. Then, from this
# directory:
#
#   terraform plan                         # note what it reports
#   terraform state list > state-before.txt
#   cp backend.tf.example backend.tf
#   cp backend.hcl.example backend.hcl     # then the subscription and account the script printed
#   terraform init -backend-config=backend.hcl -migrate-state
#   terraform state list | diff state-before.txt -    # prints nothing
#   terraform plan                         # reports what it reported before
#
# Every stack shares the container, each under its own key, so read the
# migration's question before answering. Answer yes only when it says no
# existing state was found in the new backend. If it says a state already exists
# there, the key is another stack's: press Ctrl-C, since yes would overwrite that
# state and no would take it over in place of this one's, and change the key.
#
# use_azuread_auth (in backend.hcl) means Terraform reaches the blob as you, with
# Entra ID, not with an account key: the account has keys disabled.
#
# The migration empties terraform.tfstate but leaves the old state, secrets
# included, in terraform.tfstate.backup. Once both checks pass, delete both, and
# any saved plan files, which carry the same secrets; state-before.txt can go too.
#
# From then on, pass -backend-config=backend.hcl to every terraform init: a bare
# init only works while .terraform remembers the settings, so not in a fresh
# checkout. Both backend.tf and backend.hcl are ignored by git, so each
# deployment keeps its own.
terraform {
  backend "azurerm" {}
}
