# Where the remote state lives, for the azurerm backend in backend.tf (see
# backend.tf.example for creating the account). Copy to backend.hcl and run
#   terraform init -backend-config=backend.hcl
resource_group_name  = "rg-terraform-state"
storage_account_name = "<your-state-storage-account>"
container_name       = "tfstate"
key                  = "<name>-<environment>.tfstate"
use_azuread_auth     = true
