  "ai": {
    "enabled": true,
    "providers": {
      "anthropic": {
        "enabled": true,
        "models": ["claude-fable-5-1", "claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5-20251001"],
        "endpoint": "https://api.anthropic.com/v1/messages"
      },
      "openai": {
        "enabled": true,
        "models": ["gpt-5", "gpt-5-mini", "gpt-4.1", "o4-mini"],
        "endpoint": "https://api.openai.com/v1/chat/completions"
      },
      "google": {
        "enabled": true,
        "models": ["gemini-2.5-pro", "gemini-2.5-flash"],
        "endpoint": "https://generativelanguage.googleapis.com/v1beta"
      }
    },
    "maxOutputTokens": 2000,
    "timeoutSeconds": 90,
    "historyTurns": 20,
    "maxQuestionChars": 4000,
    "snapshot": {
      "maxHolders": 120,
      "maxConvertibles": 40,
      "maxValuations": 10,
      "maxComplianceFindings": 25
    },
    "examplePrompts": [
      "Who owns the most of the company on a fully diluted basis?",
      "How much of the option pool is still unallocated?",
      "If a $2,000,000 SAFE converts at the cap, how much does each founder give up?",
      "Which equity awards are fully vested today?"
    ]
  },
  "backup": {
    "container": "backups",
    "prefix": "kosmitor",
    "drillDatabase": "kosmitor_restore_drill",
    "maxRowDrift": 5
  }
