# Environment for the API server. Copy to apps/server/.env; variables already set
# in the environment win over this file.
#
# Every other setting (the product name, limits, sign-in options, the defaults a
# new company starts with, the 409A valuation desk, the assistant) lives in
# kosmitor.config.json at the repository root. Put your changes in
# kosmitor.config.local.json next to it, holding only the entries you change.
# The variables marked "overrides" below set one entry of that file each, for
# values that differ per deployment. Secrets only ever go here, never in a file.

# PostgreSQL connection. The default works with a local server that trusts the
# current OS user (Homebrew, Postgres.app). Create the database with:
#   npm run db:create
DATABASE_URL=postgres://localhost:5432/kosmitor
# With `docker compose up -d` (compose.yaml at the repository root) use instead:
# DATABASE_URL=postgres://postgres@localhost:55432/kosmitor
# Connection pool size. Overrides database.poolMax (10).
# PG_POOL_MAX=10

# Port the API listens on. Overrides server.port (4000).
# PORT=4000
# Public address of the web app, used for every link inside messages.
# Overrides app.url. Set it to the real address in production.
# APP_URL=https://equity.example.com
# Further origins allowed to call the API from a browser, comma separated.
# Overrides server.allowedOrigins. APP_URL is always allowed, and the Vite dev
# server (localhost:5173) is allowed outside production.
# ALLOWED_ORIGINS=https://admin.example.com
# true when a reverse proxy or load balancer in front of the server sets
# X-Forwarded-For, so audit entries and signatures record the client's address
# rather than the proxy's. Leave it off when clients reach the server directly:
# the header is then whatever they chose to send. Overrides server.trustProxy.
# TRUST_PROXY=false

# Make someone who signs up open a link sent to their address before they can sign
# in. Needs SMTP_URL or ACS_CONNECTION_STRING; without one the address is taken as
# given. Off by default for a laptop or one team's server; the Azure deployment
# turns it on. Overrides auth.verifyEmail.
# VERIFY_EMAIL=false

# Sign in with Google.
# Create an "OAuth client ID" of type "Web application" at
#   https://console.cloud.google.com/apis/credentials
# and add these Authorized JavaScript origins:
#   http://localhost               (Google requires the bare origin for localhost too)
#   http://localhost:5173          (development)
#   https://your-production-host   (production)
# No redirect URI is needed — the browser posts the ID token straight to the API.
# Overrides auth.google.clientId. With neither set, Google sign-in is off.
GOOGLE_CLIENT_ID=

# Optional. Only allow Google accounts on these email domains (comma separated).
# Leave empty to accept any Google account. Overrides auth.google.allowedDomains.
GOOGLE_ALLOWED_DOMAINS=

# Where Google's signing keys are fetched from. Only tests change it.
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Outgoing mail. Azure Communication Services is what the Azure deployment
# provisions and Terraform passes this in automatically; locally you would paste
# the connection string from the Communication Services resource. It wins over
# SMTP_URL when both are set.
ACS_CONNECTION_STRING=

# The other way to send: any SMTP server. Leave both empty and the server prints
# messages to its log instead, and reset links are shown in the app outside
# production. smtp:// uses STARTTLS, smtps:// implicit TLS.
SMTP_URL=
# The sender of every message. Overrides mail.from.
# MAIL_FROM=Kosmitor <no-reply@example.com>

# Internal approval inbox for each new 409A request. Approval is required before
# evaluator delivery. Overrides valuationDesk.approvalEmail; empty uses the file
# and does not disable approval. Configure an inbox before enabling the desk.
VALUATION_APPROVAL_EMAIL=

# Where an approved 409A request is sent: the valuation team's inbox, or several
# evaluators' addresses separated by commas, each emailed on its own. Overrides
# valuationDesk.email. The desk itself is off unless valuationDesk.enabled is
# true in your kosmitor.config.local.json. With no evaluator address, approved
# requests are saved without notifying an evaluator. Internal approval still
# receives a notice; leave the mail transports unset locally to log mail only.
VALUATION_DESK_EMAIL=

# Optional Stripe billing. Keep off until products/prices, the customer portal
# and /api/stripe/webhook are configured. See docs/billing.md.
BILLING_ENABLED=false
# A JSON array of {key,name,priceId}; [] clears the file's plan list.
# STRIPE_SUBSCRIPTION_PLANS=[{"key":"standard","name":"Standard","priceId":"price_REPLACEWITHRECURRING"}]
STRIPE_VALUATION_PRICE_ID=
# Secrets stay only in this ignored .env or the deployment's secret store.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Encrypts the secrets people hand the application, which today means the API key
# behind the assistant. Set it to any long random string and keep it out of the
# database, so a stolen dump cannot be read:
#   openssl rand -base64 32
# Leave it empty and the server generates a key and stores it in its own table,
# which keeps keys out of logs and exports but not away from the database itself.
# Changing this value makes every stored key unreadable, and each person then
# pastes theirs again.
KOSMITOR_SECRET_KEY=

# Product analytics, error tracking and logs in PostHog. Leave the key empty and
# nothing leaves the server; requests and errors still print as JSON lines.
# Overrides analytics.posthog.key and analytics.posthog.host.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Where the settings are read from.
# A file of changes to use instead of kosmitor.config.local.json, absolute or
# relative to the repository root.
# KOSMITOR_CONFIG=/etc/kosmitor/settings.json
# The folder holding kosmitor.config.json and its schema, when it is not the
# repository root (/app in the container image).
# KOSMITOR_ROOT=/app
# The built web app the server hands out. Defaults to apps/web/dist.
# WEB_DIST=/app/apps/web/dist
# Files that builds before PostgreSQL kept on disk, picked up once at start.
# Defaults to apps/server/data/uploads.
# CT_LEGACY_UPLOAD_DIR=

# Off-site backups: node src/backup-upload.ts, which the Azure backup job runs.
# The storage account, https://<account>.blob.core.windows.net.
# BACKUP_ACCOUNT_URL=
# Overrides backup.container ("backups").
# BACKUP_CONTAINER=backups
# Overrides backup.prefix ("kosmitor"), the start of every blob name.
# BACKUP_PREFIX=kosmitor
# Overrides backup.drillDatabase ("kosmitor_restore_drill"), the scratch database
# the restore drill creates and drops again.
# DRILL_DATABASE=kosmitor_restore_drill
# The user-assigned managed identity the job signs in with on Azure.
# AZURE_CLIENT_ID=
# For a run from a laptop instead of a managed identity:
#   BACKUP_TOKEN=$(az account get-access-token --resource https://storage.azure.com/ --query accessToken -o tsv)
# BACKUP_TOKEN=
