{
  "name": "kosmitor",
  "private": true,
  "version": "1.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@kosmitor/server & npm run dev --workspace=@kosmitor/web",
    "start": "npm start --workspace=@kosmitor/server",
    "dev:server": "npm run dev --workspace=@kosmitor/server",
    "dev:web": "npm run dev --workspace=@kosmitor/web",
    "build": "npm run build --workspace=@kosmitor/core && npm run build --workspace=@kosmitor/web",
    "test": "npm run test --workspace=@kosmitor/core && npm run test --workspace=@kosmitor/web && npm run test --workspace=@kosmitor/server",
    "sample": "npm run sample --workspace=@kosmitor/server --",
    "reconcile": "npm run reconcile --workspace=@kosmitor/server --",
    "seed": "npm run seed --workspace=@kosmitor/server --",
    "backup": "npm run backup --workspace=@kosmitor/server --",
    "db:create": "npm run db:create --workspace=@kosmitor/server",
    "db:migrate-sqlite": "npm run db:migrate-sqlite --workspace=@kosmitor/server --",
    "config:docs": "npm run config:docs --workspace=@kosmitor/server --",
    "emails:preview": "npm run emails:preview --workspace=@kosmitor/server --"
  }
}
